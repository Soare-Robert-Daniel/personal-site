		const lowpass = trackNode(new Tone.Filter(320, 'lowpass'));
		const kickGain = trackNode(new Tone.Gain(1));
		const subGain = trackNode(new Tone.Gain(0.42));
		const bassGain = trackNode(new Tone.Gain(0.28));
		const tomGain = trackNode(new Tone.Gain(0.18));

		kick.chain(kickGain, mixBus!);
		sub.chain(lowpass, subGain, mixBus!);
		bass.chain(lowpass, bassGain, mixBus!);
		tom.chain(tomGain, mixBus!);

		const roots = ['A0', 'A0', 'A0', 'A0', 'C1', 'C1', 'C1', 'C1', 'G0', 'G0', 'G0', 'G0', 'D1', 'D1', 'D1', 'D1'];
		const growls = ['A1', null, 'A1', 'C2', null, 'C2', 'G1', null, 'G1', 'D2', null, 'D2', 'A1', null, 'C2', 'G1'];

		trackPart(new Tone.Sequence((time, step) => {
			kick.triggerAttackRelease('C1', '8n', time, 1);
			sub.triggerAttackRelease(roots[step], '8n', time, 0.9);
			const growl = growls[step];
			if (growl) bass.triggerAttackRelease(growl, '16n', time, 0.75);
			if (step % 8 === 4) tom.triggerAttackRelease('G1', '8n', time, 0.55);
		}, Array.from({ length: 16 }, (_, i) => i), '8n').start(0));
