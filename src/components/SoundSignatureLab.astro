	function buildMidBandPreset() {
		const keys = trackNode(new Tone.PolySynth(Tone.Synth, {
			oscillator: { type: 'triangle' },
			envelope: { attack: 0.03, decay: 0.25, sustain: 0.45, release: 0.5 },
		}));
		const voice = trackNode(new Tone.Synth({
			oscillator: { type: 'sine' },
			envelope: { attack: 0.02, decay: 0.2, sustain: 0.35, release: 0.35 },
		}));
		const harmony = trackNode(new Tone.Synth({
			oscillator: { type: 'triangle' },
			envelope: { attack: 0.03, decay: 0.22, sustain: 0.3, release: 0.4 },
		}));
		const body = trackNode(new Tone.MonoSynth({
			oscillator: { type: 'triangle' },
			filter: { type: 'bandpass', Q: 0.9, rolloff: -12 },
			filterEnvelope: { attack: 0.02, decay: 0.2, sustain: 0.4, release: 0.25, baseFrequency: 450, octaves: 1.2 },
			envelope: { attack: 0.02, decay: 0.2, sustain: 0.35, release: 0.3 },
		}));

		const band = trackNode(new Tone.Filter({ type: 'bandpass', frequency: 1100, Q: 0.7 }));
		const highcut = trackNode(new Tone.Filter(4200, 'lowpass'));
		const lowcut = trackNode(new Tone.Filter(180, 'highpass'));
		const reverb = trackNode(new Tone.Reverb({ decay: 2.2, wet: 0.18 }));
		const keysGain = trackNode(new Tone.Gain(0.16));
		const voiceGain = trackNode(new Tone.Gain(0.14));
		const harmonyGain = trackNode(new Tone.Gain(0.1));
		const bodyGain = trackNode(new Tone.Gain(0.14));

		keys.chain(lowcut, band, highcut, keysGain, reverb, mixBus!);
		voice.chain(lowcut, band, highcut, voiceGain, reverb, mixBus!);
		harmony.chain(lowcut, band, highcut, harmonyGain, reverb, mixBus!);
		body.chain(lowcut, highcut, bodyGain, mixBus!);

		const chords = [
			['A3', 'C4', 'E4'],
			['F3', 'A3', 'C4'],
			['C3', 'E3', 'G3'],
			['G3', 'B3', 'D4'],
		];
		const melody = ['E4', null, 'A4', 'C5', null, 'B4', 'A4', null, 'G4', 'E4', null, 'C5', 'D5', null, 'C5', 'A4'];
		const bodyNotes = ['A2', null, 'A2', 'C3', null, 'F2', null, 'G2', 'A2', null, 'C3', 'E3', null, 'G2', 'A2', null];

		trackPart(new Tone.Sequence((time, step) => {
			if (step % 4 === 0) keys.triggerAttackRelease(chords[Math.floor(step / 4) % chords.length], '2n', time, 0.4);
			const note = melody[step];
			if (note) {
				voice.triggerAttackRelease(note, '8n', time, 0.55);
				harmony.triggerAttackRelease(Tone.Frequency(note).transpose(-5).toNote(), '8n', time, 0.28);
			}
			const bodyNote = bodyNotes[step];
			if (bodyNote) body.triggerAttackRelease(bodyNote, '8n', time, 0.5);
		}, Array.from({ length: 16 }, (_, i) => i), '8n').start(0));
	}

	function buildAirPreset() {
		const hat = trackNode(new Tone.NoiseSynth({
			noise: { type: 'white' },
			envelope: { attack: 0.001, decay: 0.045, sustain: 0, release: 0.02 },
		}));
		const shaker = trackNode(new Tone.NoiseSynth({
			noise: { type: 'pink' },
			envelope: { attack: 0.001, decay: 0.08, sustain: 0, release: 0.03 },
		}));
		const bell = trackNode(new Tone.FMSynth({
			modulationIndex: 12,
			oscillator: { type: 'sine' },
			modulation: { type: 'sine' },
			envelope: { attack: 0.001, decay: 0.5, sustain: 0.02, release: 0.5 },
			modulationEnvelope: { attack: 0.001, decay: 0.25, sustain: 0.05, release: 0.25 },
		}));
		const sparkle = trackNode(new Tone.MetalSynth({
			envelope: { attack: 0.001, decay: 0.18, release: 0.05 },
			harmonicity: 6.2,
			modulationIndex: 28,
			resonance: 5500,
			octaves: 1.6,
		}));
		const highLead = trackNode(new Tone.Synth({
			oscillator: { type: 'square' },
			envelope: { attack: 0.004, decay: 0.1, sustain: 0.08, release: 0.1 },
		}));

		const hipass = trackNode(new Tone.Filter(1800, 'highpass'));
		const airShelf = trackNode(new Tone.Filter(7000, 'highpass'));
		const delay = trackNode(new Tone.PingPongDelay('16n', 0.25));
		const reverb = trackNode(new Tone.Reverb({ decay: 2.8, wet: 0.28 }));
		const hatGain = trackNode(new Tone.Gain(0.07));
		const shakerGain = trackNode(new Tone.Gain(0.05));
		const bellGain = trackNode(new Tone.Gain(0.08));
		const sparkleGain = trackNode(new Tone.Gain(0.04));
		const leadGain = trackNode(new Tone.Gain(0.08));

		hat.chain(hipass, hatGain, reverb, mixBus!);
		shaker.chain(airShelf, shakerGain, reverb, mixBus!);
		bell.chain(hipass, delay, bellGain, reverb, mixBus!);
		sparkle.chain(airShelf, sparkleGain, reverb, mixBus!);
		highLead.chain(hipass, delay, leadGain, reverb, mixBus!);

		const bells = ['E6', null, 'B5', 'F#6', null, 'A5', 'C#6', null, 'G#5', 'E6', null, 'B5', 'F#6', null, 'A5', 'C#6'];
		const lead = ['E5', 'F#5', null, 'A5', 'B5', null, 'C#6', 'B5', null, 'A5', 'F#5', null, 'E5', 'F#5', 'A5', null];

		trackPart(new Tone.Sequence((time, step) => {
			hat.triggerAttackRelease('32n', time, step % 2 === 0 ? 0.45 : 0.25);
			if (step % 3 === 0) shaker.triggerAttackRelease('16n', time, 0.3);
			if (step % 4 === 2) sparkle.triggerAttackRelease('16n', time, 0.22);
			const bellNote = bells[step];
			if (bellNote) bell.triggerAttackRelease(bellNote, '8n', time, 0.35);
			const leadNote = lead[step];
			if (leadNote) highLead.triggerAttackRelease(leadNote, '16n', time, 0.35);
		}, Array.from({ length: 16 }, (_, i) => i), '16n').start(0));
	}

	function buildLofiPreset() {
