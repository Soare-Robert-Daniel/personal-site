<div id="sound-signature-lab">
	<section class="response-panel" aria-labelledby="signature-heading">
		<div class="panel-heading">
			<div>
				<p class="eyebrow">Original signal → transformed sound</p>
				<h2 id="signature-heading">Choose a sound signature</h2>
			</div>
			<p id="signature-summary" class="summary" aria-live="polite"></p>
		</div>

		<p class="picker-label">Pick a signature to transform the playing music. Each tile shows the filter curve and a live comparison of the unprocessed source beside that signature's processed result.</p>
		<div id="signature-tiles" class="signature-tiles" role="group" aria-label="Choose a sound signature"></div>

		<div class="controls">
			<div class="preset-row" role="group" aria-label="Music preset">
				<span class="control-label">Music</span>
				<button class="preset-button mode-button active" type="button" data-preset="edm" aria-pressed="true">EDM</button>
				<button class="preset-button mode-button" type="button" data-preset="lofi" aria-pressed="false">Lo-fi</button>
				<button class="preset-button mode-button" type="button" data-preset="ambient" aria-pressed="false">Ambient</button>
				<button class="preset-button mode-button" type="button" data-preset="arp" aria-pressed="false">Arpeggio</button>
			</div>
			<div class="level-row">
				<div class="label-row">
					<label for="volume">Listening level</label>
					<output id="volume-value" for="volume">8%</output>
				</div>
				<input id="volume" type="range" min="0" max="20" value="8" step="1" />
			</div>
			<div class="action-row">
				<button id="toggle-signal" type="button">Start listening</button>
			</div>
		</div>
		<p id="playback-status" class="playback-status" aria-live="polite">Ready. Pick a signature and press Start listening.</p>
		<p class="safety-note"><strong>Hearing safety:</strong> begin at the minimum volume. Keep this a gentle listening test, then stop if you hear discomfort or ringing.</p>
	</section>
</div>

<script>
	import * as Tone from 'tone';

	type Signature = {
		id: string;
		name: string;
		type: string;
		description: string;
		color: string;
		eq: [number, number, number, number, number];
		eqSummary: string;
	};

	type MusicStyle = 'edm' | 'lofi' | 'ambient' | 'arp';

	type MusicPreset = {
		id: MusicStyle;
		name: string;
		tempo: number;
	};

	const signatures: Signature[] = [
		{ id: 'neutral', name: 'Neutral', type: 'Flat reference', description: 'The original flat reference. No tonal transformation is applied.', color: '#70e6c4', eq: [0, 0, 0, 0, 0], eqSummary: 'Bass 0 · Mids 0 · Treble 0' },
		{ id: 'bright', name: 'Bright', type: 'Strong treble boost', description: 'Clearly lifts presence and sparkle while keeping bass close to the original.', color: '#f5d06f', eq: [0, -1, 0, 6, 9], eqSummary: 'Bass 0 · Mids 0 · Treble +9' },
		{ id: 'dark', name: 'Dark', type: 'Strong treble cut', description: 'Clearly softens presence and air for a darker, relaxed result.', color: '#8c9cb8', eq: [2, 2, 0, -5, -10], eqSummary: 'Bass +2 · Mids 0 · Treble −10' },
		{ id: 'warm', name: 'Warm', type: 'Strong bass lift', description: 'Clearly lifts bass and lower mids, then rolls back upper treble.', color: '#e89565', eq: [7, 6, 2, -3, -5], eqSummary: 'Bass +7 · Mids +2 · Treble −5' },
		{ id: 'cold', name: 'Cold', type: 'Strong lean / cold', description: 'Clearly removes low-end weight and brings forward clarity and edge.', color: '#70c8ee', eq: [-7, -5, 0, 6, 6], eqSummary: 'Bass −7 · Mids 0 · Treble +6' },
		{ id: 'v-shaped', name: 'V-shaped', type: 'Extreme V', description: 'Strongly raises bass and treble while pushing the middle behind the mix.', color: '#d878df', eq: [10, 4, -7, 7, 10], eqSummary: 'Bass +10 · Mids −7 · Treble +10' },
	];
	const musicPresets: MusicPreset[] = [
		{ id: 'edm', name: 'EDM', tempo: 128 },
		{ id: 'lofi', name: 'Lo-fi', tempo: 84 },
		{ id: 'ambient', name: 'Ambient', tempo: 70 },
		{ id: 'arp', name: 'Arpeggio', tempo: 110 },
	];

	const tileGrid = document.getElementById('signature-tiles')!;
	const summary = document.getElementById('signature-summary')!;
	const volume = document.getElementById('volume') as HTMLInputElement;
	const volumeValue = document.getElementById('volume-value') as HTMLOutputElement;
	const toggleButton = document.getElementById('toggle-signal') as HTMLButtonElement;
	const playbackStatus = document.getElementById('playback-status')!;
	const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset-button'));

	let selected = signatures[0];
	let audioContext: AudioContext | null = null;
	let masterGain: GainNode | null = null;
	let eqFilters: BiquadFilterNode[] = [];
	let rawAnalyser: AnalyserNode | null = null;
	let analyserSink: GainNode | null = null;
	let mixBus: Tone.Gain | null = null;
	let toneNodes: Tone.ToneAudioNode[] = [];
	let toneParts: Array<Tone.Sequence | Tone.Part | Tone.Loop> = [];
	let monitorFrame = 0;
	let monitorRunning = false;
	let activePreset = musicPresets[0];
	const signalCanvases = new Map<string, HTMLCanvasElement>();
	const curveCanvases = new Map<string, HTMLCanvasElement>();
	let liveBarFreqs = getBarFrequencies(48000);
	const eqMultCache = new Map<string, number[]>();

	let analysisContext: AudioContext | null = null;

	function getAnalysisContext() {
		analysisContext ??= new AudioContext({ sampleRate: 48000 });
		return analysisContext;
	}

	function computeFilterResponse(eq: [number, number, number, number, number], sampleCount = 100) {
		const context = getAnalysisContext();
		const filterSpecs: Array<[BiquadFilterType, number, number]> = [
			['lowshelf', 100, 1],
			['peaking', 250, 0.9],
			['peaking', 1000, 1],
			['peaking', 3500, 1],
			['highshelf', 8000, 1],
		];
		const filters = filterSpecs.map(([type, frequency, q], index) => {
			const filter = context.createBiquadFilter();
			filter.type = type;
			filter.frequency.value = frequency;
			filter.Q.value = q;
			filter.gain.value = eq[index];
			return filter;
		});
		const frequencies = new Float32Array(sampleCount);
		const minLog = Math.log10(20);
		const maxLog = Math.log10(20000);
		for (let i = 0; i < frequencies.length; i++) {
			frequencies[i] = 10 ** (minLog + (i / (frequencies.length - 1)) * (maxLog - minLog));
		}
		const decibels = new Float32Array(frequencies.length);
		filters.forEach((filter) => {
			const magnitudes = new Float32Array(frequencies.length);
			filter.getFrequencyResponse(frequencies, magnitudes, new Float32Array(frequencies.length));
			magnitudes.forEach((magnitude, index) => {
				decibels[index] += 20 * Math.log10(magnitude);
			});
		});
		return { frequencies: Array.from(frequencies), decibels: Array.from(decibels) };
	}

	function drawMiniChart(miniCanvas: HTMLCanvasElement, signature: Signature) {
		const rect = miniCanvas.getBoundingClientRect();
		const width = Math.max(120, rect.width);
		const height = 88;
		const dpr = window.devicePixelRatio || 1;
		miniCanvas.width = Math.max(1, Math.floor(width * dpr));
		miniCanvas.height = Math.max(1, Math.floor(height * dpr));
		const context = miniCanvas.getContext('2d')!;
		context.setTransform(dpr, 0, 0, dpr, 0, 0);
		const { decibels } = computeFilterResponse(signature.eq);
		const leftPad = 28;
		const rightPad = 6;
		const topPad = 8;
		const bottomPad = 8;
		const graphWidth = Math.max(1, width - leftPad - rightPad);
		const graphHeight = Math.max(1, height - topPad - bottomPad);
		const baseline = topPad + graphHeight / 2;
		const dbScale = Math.max(12, Math.ceil((Math.max(...decibels.map((value) => Math.abs(value))) + 2) / 6) * 6);
		const tickStep = dbScale > 18 ? 12 : 6;
		const yFor = (db: number) => baseline - (db / dbScale) * (graphHeight / 2);

		context.clearRect(0, 0, width, height);
		context.fillStyle = 'rgba(10, 15, 28, 0.6)';
		context.fillRect(0, 0, width, height);

		context.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
		context.textAlign = 'right';
		context.textBaseline = 'middle';
		for (let db = -dbScale; db <= dbScale; db += tickStep) {
			const y = yFor(db);
			context.strokeStyle = db === 0 ? 'rgba(170, 182, 206, 0.42)' : 'rgba(170, 182, 206, 0.14)';
			context.setLineDash(db === 0 ? [3, 3] : []);
			context.lineWidth = db === 0 ? 1 : 1;
			context.beginPath();
			context.moveTo(leftPad, y);
			context.lineTo(width - rightPad, y);
			context.stroke();
			context.setLineDash([]);
			context.fillStyle = 'rgba(170, 182, 206, 0.72)';
			context.fillText(`${db > 0 ? '+' : ''}${db}`, leftPad - 4, y);
		}

		function drawCurve(stroke: string, fill: string, data: number[], lineWidth: number, glow = false) {
			context.beginPath();
			data.forEach((db, index) => {
				const x = leftPad + (index / (data.length - 1)) * graphWidth;
				const y = yFor(db);
				if (index === 0) context.moveTo(x, y);
				else context.lineTo(x, y);
			});
			context.strokeStyle = stroke;
			context.lineWidth = lineWidth;
			context.lineJoin = 'round';
			context.lineCap = 'round';
			if (glow) {
				context.shadowColor = stroke;
				context.shadowBlur = 12;
			}
			context.stroke();
			context.shadowBlur = 0;
			context.lineTo(leftPad + graphWidth, baseline);
			context.lineTo(leftPad, baseline);
			context.closePath();
			const gradient = context.createLinearGradient(0, topPad, 0, height - bottomPad);
			gradient.addColorStop(0, fill);
			gradient.addColorStop(1, 'transparent');
			context.fillStyle = gradient;
			context.fill();
		}

		const flatLine = new Array(decibels.length).fill(0);
		drawCurve('rgba(170, 182, 206, 0.5)', 'rgba(170, 182, 206, 0.08)', flatLine, 1.75);
		drawCurve(signature.color, `${signature.color}40`, decibels, 3, true);
	}

	function interpDb(frequencies: number[], decibels: number[], frequency: number) {
		if (frequency <= frequencies[0]) return decibels[0];
		if (frequency >= frequencies[frequencies.length - 1]) return decibels[decibels.length - 1];
		for (let i = 1; i < frequencies.length; i++) {
			if (frequencies[i] >= frequency) {
				const t = (frequency - frequencies[i - 1]) / (frequencies[i] - frequencies[i - 1]);
				return decibels[i - 1] + t * (decibels[i] - decibels[i - 1]);
			}
		}
		return decibels[decibels.length - 1];
	}

	function eqMultipliers(signature: Signature) {
		const cached = eqMultCache.get(signature.id);
		if (cached) return cached;
		const { frequencies, decibels } = computeFilterResponse(signature.eq);
		const mult = liveBarFreqs.map((frequency) => 10 ** (interpDb(frequencies, decibels, frequency) / 20));
		eqMultCache.set(signature.id, mult);
		return mult;
	}

	function drawSpectrumBars(target: HTMLCanvasElement, sourceBars: number[], processedBars: number[], color: string, live: boolean) {
		const rect = target.getBoundingClientRect();
		const dpr = window.devicePixelRatio || 1;
		if (target.width !== Math.floor(rect.width * dpr) || target.height !== Math.floor(rect.height * dpr)) {
			target.width = Math.max(1, Math.floor(rect.width * dpr));
			target.height = Math.max(1, Math.floor(rect.height * dpr));
		}
		const context = target.getContext('2d')!;
		context.setTransform(dpr, 0, 0, dpr, 0, 0);
		const width = rect.width;
		const height = rect.height;
		context.clearRect(0, 0, width, height);
		context.fillStyle = 'rgba(10, 15, 28, 0.5)';
		context.fillRect(0, 0, width, height);

		// Shared peak so source vs processed stays comparable without clipping extreme EQ boosts.
		let peak = 0.001;
		sourceBars.forEach((value, index) => {
			peak = Math.max(peak, value, processedBars[index] ?? value);
		});
		const scale = 0.82 / peak;
		const usableHeight = height - 10;

		const groupWidth = width / sourceBars.length;
		const gap = Math.min(2, groupWidth * 0.14);
		const barWidth = Math.max(1, (groupWidth - gap * 2) / 2);
		const drawBar = (value: number, x: number, fill: string) => {
			const barHeight = Math.max(2, value * scale * usableHeight);
			const y = height - 5 - barHeight;
			const gradient = context.createLinearGradient(0, height, 0, y);
			gradient.addColorStop(0, `${fill}20`);
			gradient.addColorStop(1, live ? fill : `${fill}88`);
			context.fillStyle = gradient;
			context.fillRect(x, y, barWidth, barHeight);
		};

		sourceBars.forEach((value, index) => {
			const groupX = index * groupWidth + gap / 2;
			drawBar(value, groupX, '#aab6ce');
			drawBar(processedBars[index] ?? value, groupX + barWidth + gap, color);
		});
	}

	function computeSourceSpectrumBars() {
		const barCount = 32;
		return Array.from({ length: barCount }, (_, index) => {
			const position = index / (barCount - 1);
			// Mild contour leaves headroom for strong EQ boosts before shared normalization.
			const contour = 0.28 + 0.22 * Math.sin(position * Math.PI * 0.9) ** 2;
			const pulse = 0.06 * Math.sin(index * 1.7) ** 2;
			return contour + pulse;
		});
	}

	function computeRawSpectrumBars() {
		if (!rawAnalyser || !audioContext) return null;
		const data = new Uint8Array(rawAnalyser.frequencyBinCount);
		rawAnalyser.getByteFrequencyData(data);
		const nyquist = audioContext.sampleRate / 2;
		const barCount = 32;
		return Array.from({ length: barCount }, (_, index) => {
			const low = (index / barCount) ** 2 * nyquist;
			const high = ((index + 1) / barCount) ** 2 * nyquist;
			let sum = 0;
			let count = 0;
			for (let i = 0; i < data.length; i++) {
				const frequency = (i / data.length) * nyquist;
				if (frequency >= low && frequency < high) {
					sum += data[i];
					count++;
				}
			}
			return count ? sum / count / 255 : 0;
		});
	}

	function getBarFrequencies(sampleRate: number) {
		const nyquist = sampleRate / 2;
		return Array.from({ length: 32 }, (_, index) => {
			const low = (index / 32) ** 2 * nyquist;
			const high = ((index + 1) / 32) ** 2 * nyquist;
			return (low + high) / 2;
		});
	}

	function computeLiveShapedBars(signature: Signature, rawBars: number[]) {
		const mult = eqMultipliers(signature);
		// Keep linear gain intact; drawSpectrumBars normalizes by shared peak.
		return rawBars.map((value, index) => Math.max(0.02, value * (mult[index] ?? 1)));
	}

	function updateSignalCanvases() {
		const rawBars = monitorRunning ? computeRawSpectrumBars() : null;
		const sourceBars = rawBars ?? computeSourceSpectrumBars();
		signatures.forEach((signature) => {
			const target = signalCanvases.get(signature.id);
			if (!target) return;
			const bars = rawBars ? computeLiveShapedBars(signature, rawBars) : computeLiveShapedBars(signature, sourceBars);
			drawSpectrumBars(target, sourceBars, bars, signature.color, !!rawBars);
		});
		if (monitorRunning) monitorFrame = requestAnimationFrame(updateSignalCanvases);
	}

	function selectSignature(signature: Signature) {
		selected = signature;
		summary.textContent = `${signature.type}. ${signature.description}`;
		tileGrid.querySelectorAll<HTMLElement>('.sig-tile').forEach((tile) => {
			const active = tile.dataset.signature === signature.id;
			tile.classList.toggle('active', active);
			tile.setAttribute('aria-pressed', String(active));
		});
		applySignatureEq(signature);
		if (!monitorRunning) {
			updateSignalCanvases();
			playbackStatus.textContent = `${signature.name} selected. Press Start listening to hear its transformation.`;
		} else {
			playbackStatus.textContent = `Now hearing the ${signature.name.toLowerCase()} transformation.`;
		}
	}

	signatures.forEach((signature) => {
		const tile = document.createElement('button');
		tile.type = 'button';
		tile.className = `sig-tile${signature.id === selected.id ? ' active' : ''}`;
		tile.dataset.signature = signature.id;
		tile.setAttribute('aria-pressed', String(signature.id === selected.id));
		tile.style.setProperty('--sig-color', signature.color);
		tile.addEventListener('click', () => selectSignature(signature));

		const head = document.createElement('span');
		head.className = 'sig-tile-head';
		const name = document.createElement('span');
		name.className = 'sig-name';
		name.textContent = signature.name;
		const type = document.createElement('span');
		type.className = 'sig-type';
		type.textContent = signature.type;
		head.append(name, type);

		const eq = document.createElement('span');
		eq.className = 'sig-eq';
		eq.textContent = signature.eqSummary;

		const viz = document.createElement('span');
		viz.className = 'viz';

		const curveItem = document.createElement('span');
		curveItem.className = 'viz-item';
		const curveLabel = document.createElement('span');
		curveLabel.className = 'viz-label';
		curveLabel.textContent = 'Filter curve';
		const curveCanvas = document.createElement('canvas');
		curveCanvas.className = 'curve-canvas';
		curveCanvas.style.width = '100%';
		curveCanvas.style.height = '88px';
		curveCanvas.style.display = 'block';
		curveCanvas.setAttribute('aria-label', `${signature.name} filter curve: ${signature.eqSummary}`);
		curveCanvases.set(signature.id, curveCanvas);
		curveItem.append(curveLabel, curveCanvas);

		const signalItem = document.createElement('span');
		signalItem.className = 'viz-item';
		const signalLabel = document.createElement('span');
		signalLabel.className = 'viz-label';
		signalLabel.textContent = 'Live signal, source (gray) / processed (color)';
		const signalCanvas = document.createElement('canvas');
		signalCanvas.className = 'signal-canvas';
		signalCanvas.style.width = '100%';
		signalCanvas.style.height = '88px';
		signalCanvas.style.display = 'block';
		signalCanvas.setAttribute('aria-label', `${signature.name} grouped bar chart comparing original and processed live signal`);
		signalCanvases.set(signature.id, signalCanvas);
		signalItem.append(signalLabel, signalCanvas);

		viz.append(curveItem, signalItem);
		tile.append(head, eq, viz);
		tileGrid.appendChild(tile);
	});

	function redrawCurves() {
		signatures.forEach((signature) => {
			const curveCanvas = curveCanvases.get(signature.id);
			if (curveCanvas) drawMiniChart(curveCanvas, signature);
		});
	}

	function updateOutputs() {
		volumeValue.textContent = `${volume.value}%`;
		if (monitorRunning && masterGain && audioContext) {
			const now = audioContext.currentTime;
			masterGain.gain.cancelScheduledValues(now);
			masterGain.gain.setValueAtTime(masterGain.gain.value, now);
			masterGain.gain.linearRampToValueAtTime(Number(volume.value) / 100, now + 0.04);
		}
		if (!monitorRunning) updateSignalCanvases();
	}

	function disposeToneGraph() {
		toneParts.forEach((part) => {
			part.stop();
			part.dispose();
		});
		toneParts = [];
		toneNodes.forEach((node) => node.dispose());
		toneNodes = [];
		mixBus?.dispose();
		mixBus = null;
		Tone.Transport.stop();
		Tone.Transport.cancel(0);
		Tone.Transport.position = 0;
	}

	function stopSignal(announce = true) {
		if (!monitorRunning && !audioContext) return;
		const now = audioContext?.currentTime ?? 0;
		masterGain?.gain.cancelScheduledValues(now);
		if (masterGain && audioContext) {
			masterGain.gain.setValueAtTime(masterGain.gain.value, now);
			masterGain.gain.linearRampToValueAtTime(0, now + 0.03);
		}
		disposeToneGraph();
		if (masterGain && eqFilters[0]) {
			try { masterGain.disconnect(); } catch { /* already disconnected */ }
			try { eqFilters[0].disconnect(); } catch { /* already disconnected */ }
		}
		analyserSink?.disconnect();
		rawAnalyser?.disconnect();
		masterGain = null;
		eqFilters = [];
		rawAnalyser = null;
		analyserSink = null;
		monitorRunning = false;
		cancelAnimationFrame(monitorFrame);
		updateSignalCanvases();
		toggleButton.textContent = 'Start listening';
		if (announce) playbackStatus.textContent = 'Stopped. Pick a signature and press Start listening.';
	}

	function applySignatureEq(signature: Signature) {
		if (!audioContext || !eqFilters.length) return;
		const now = audioContext.currentTime;
		eqFilters.forEach((filter, index) => {
			filter.gain.cancelScheduledValues(now);
			filter.gain.setValueAtTime(filter.gain.value, now);
			filter.gain.linearRampToValueAtTime(signature.eq[index], now + 0.06);
		});
	}

	function trackNode<T extends Tone.ToneAudioNode>(node: T): T {
		toneNodes.push(node);
		return node;
	}

	function trackPart<T extends Tone.Sequence | Tone.Part | Tone.Loop>(part: T): T {
		toneParts.push(part);
		return part;
	}

	function connectToBus(node: Tone.ToneAudioNode) {
		if (!mixBus) return;
		node.connect(mixBus);
	}

	function buildEdmPreset() {
		const kick = trackNode(new Tone.MembraneSynth({
			pitchDecay: 0.05,
			octaves: 6,
			oscillator: { type: 'sine' },
			envelope: { attack: 0.001, decay: 0.28, sustain: 0.01, release: 0.18 },
		}));
		const bass = trackNode(new Tone.MonoSynth({
			oscillator: { type: 'sawtooth' },
			filter: { type: 'lowpass', Q: 2, rolloff: -24 },
			filterEnvelope: { attack: 0.01, decay: 0.12, sustain: 0.2, release: 0.12, baseFrequency: 80, octaves: 2.2 },
			envelope: { attack: 0.01, decay: 0.18, sustain: 0.25, release: 0.12 },
		}));
		const pad = trackNode(new Tone.PolySynth(Tone.Synth, {
			oscillator: { type: 'fatsawtooth', count: 3, spread: 18 },
			envelope: { attack: 0.08, decay: 0.2, sustain: 0.45, release: 0.35 },
		}));
		const lead = trackNode(new Tone.Synth({
			oscillator: { type: 'square' },
			envelope: { attack: 0.005, decay: 0.12, sustain: 0.15, release: 0.1 },
		}));
		const hat = trackNode(new Tone.NoiseSynth({
			noise: { type: 'white' },
			envelope: { attack: 0.001, decay: 0.05, sustain: 0, release: 0.02 },
		}));
		const clap = trackNode(new Tone.NoiseSynth({
			noise: { type: 'pink' },
			envelope: { attack: 0.001, decay: 0.16, sustain: 0, release: 0.05 },
		}));

		const kickGain = trackNode(new Tone.Gain(0.9));
		const bassGain = trackNode(new Tone.Gain(0.28));
		const padGain = trackNode(new Tone.Gain(0.12));
		const leadGain = trackNode(new Tone.Gain(0.11));
		const hatGain = trackNode(new Tone.Gain(0.05));
		const clapGain = trackNode(new Tone.Gain(0.08));
		const delay = trackNode(new Tone.FeedbackDelay('8n', 0.18));
		const reverb = trackNode(new Tone.Reverb({ decay: 1.6, wet: 0.12 }));

		kick.connect(kickGain);
		bass.connect(bassGain);
		pad.connect(padGain);
		lead.chain(delay, leadGain);
		hat.connect(hatGain);
		clap.connect(clapGain);
		[kickGain, bassGain, padGain, leadGain, hatGain, clapGain].forEach((gain) => gain.chain(reverb, mixBus!));

		const bassNotes = ['A1', 'A1', 'A1', 'A1', 'C2', 'C2', 'C2', 'C2', 'G1', 'G1', 'G1', 'G1', 'D2', 'D2', 'D2', 'D2'];
		const leadNotes = ['A4', null, 'C5', 'E5', 'A4', null, 'G4', 'C5', 'E5', null, 'G5', 'A5', 'G5', 'E5', 'C5', 'A4'];
		const chords = [
			['A3', 'C4', 'E4', 'G4'],
			['C4', 'E4', 'G4', 'B4'],
			['G3', 'B3', 'D4', 'F4'],
			['D4', 'F4', 'A4', 'C5'],
		];

		trackPart(new Tone.Sequence((time, note) => {
			kick.triggerAttackRelease('C1', '8n', time, 0.95);
			if (note) bass.triggerAttackRelease(note, '8n', time, 0.8);
		}, bassNotes, '8n').start(0));

		trackPart(new Tone.Sequence((time, step) => {
			if (step % 2 === 1) hat.triggerAttackRelease('16n', time, 0.35);
			if (step % 4 === 2) clap.triggerAttackRelease('8n', time, 0.55);
			if (step % 8 === 0) pad.triggerAttackRelease(chords[Math.floor(step / 4) % chords.length], '2n', time, 0.35);
			const leadNote = leadNotes[step];
			if (leadNote) lead.triggerAttackRelease(leadNote, '16n', time, 0.45);
		}, Array.from({ length: 16 }, (_, i) => i), '8n').start(0));
	}

	function buildLofiPreset() {
		const keys = trackNode(new Tone.PolySynth(Tone.Synth, {
			oscillator: { type: 'triangle' },
			envelope: { attack: 0.04, decay: 0.35, sustain: 0.4, release: 0.8 },
		}));
		const bass = trackNode(new Tone.MonoSynth({
			oscillator: { type: 'triangle' },
			filter: { type: 'lowpass', Q: 1, rolloff: -12 },
			filterEnvelope: { attack: 0.02, decay: 0.2, sustain: 0.3, release: 0.3, baseFrequency: 90, octaves: 1.5 },
			envelope: { attack: 0.02, decay: 0.25, sustain: 0.3, release: 0.35 },
		}));
		const lead = trackNode(new Tone.Synth({
			oscillator: { type: 'sine' },
			envelope: { attack: 0.01, decay: 0.25, sustain: 0.15, release: 0.4 },
		}));
		const kick = trackNode(new Tone.MembraneSynth({
			pitchDecay: 0.03,
			octaves: 3.5,
			envelope: { attack: 0.001, decay: 0.25, sustain: 0, release: 0.15 },
		}));
		const snare = trackNode(new Tone.NoiseSynth({
			noise: { type: 'brown' },
			envelope: { attack: 0.001, decay: 0.18, sustain: 0, release: 0.08 },
		}));
		const dust = trackNode(new Tone.NoiseSynth({
			noise: { type: 'pink' },
			envelope: { attack: 0.2, decay: 0.8, sustain: 0.15, release: 0.6 },
		}));

		const filter = trackNode(new Tone.Filter(2200, 'lowpass'));
		const chorus = trackNode(new Tone.Chorus(2.5, 1.8, 0.35).start());
		const reverb = trackNode(new Tone.Reverb({ decay: 2.4, wet: 0.22 }));
		const keysGain = trackNode(new Tone.Gain(0.16));
		const bassGain = trackNode(new Tone.Gain(0.2));
		const leadGain = trackNode(new Tone.Gain(0.1));
		const kickGain = trackNode(new Tone.Gain(0.55));
		const snareGain = trackNode(new Tone.Gain(0.08));
		const dustGain = trackNode(new Tone.Gain(0.03));

		keys.chain(chorus, filter, keysGain, reverb, mixBus!);
		bass.chain(bassGain, mixBus!);
		lead.chain(filter, leadGain, reverb, mixBus!);
		kick.connect(kickGain);
		snare.connect(snareGain);
		dust.connect(dustGain);
		[kickGain, snareGain, dustGain].forEach((gain) => connectToBus(gain));

		const chords = [
			['F3', 'Ab3', 'C4', 'Eb4'],
			['Db3', 'F3', 'Ab3', 'C4'],
			['Eb3', 'G3', 'Bb3', 'Db4'],
			['Ab2', 'C3', 'Eb3', 'G3'],
		];
		const bassNotes = ['F2', null, 'F2', 'Ab2', null, 'Db2', null, 'Eb2', 'Ab2', null, 'Ab2', 'C3', null, 'Eb2', 'F2', null];
		const leadNotes = ['C5', null, 'Eb5', 'F5', null, 'Eb5', 'C5', null, 'Ab4', 'C5', null, 'F5', 'G5', null, 'F5', 'Eb5'];

		Tone.Transport.swing = 0.18;
		Tone.Transport.swingSubdivision = '8n';

		trackPart(new Tone.Sequence((time, step) => {
			if (step % 4 === 0) {
				keys.triggerAttackRelease(chords[Math.floor(step / 4) % chords.length], '2n', time, 0.4);
				dust.triggerAttackRelease('4n', time, 0.2);
			}
			if (step % 8 === 0) kick.triggerAttackRelease('C1', '8n', time, 0.7);
			if (step % 8 === 4) snare.triggerAttackRelease('8n', time, 0.4);
			const bassNote = bassNotes[step];
			if (bassNote) bass.triggerAttackRelease(bassNote, '8n', time, 0.55);
			const leadNote = leadNotes[step];
			if (leadNote) lead.triggerAttackRelease(leadNote, '8n', time, 0.35);
		}, Array.from({ length: 16 }, (_, i) => i), '8n').start(0));
	}

	function buildAmbientPreset() {
		const pad = trackNode(new Tone.PolySynth(Tone.Synth, {
			oscillator: { type: 'sine' },
			envelope: { attack: 1.2, decay: 1.5, sustain: 0.7, release: 2.5 },
		}));
		const drone = trackNode(new Tone.MonoSynth({
			oscillator: { type: 'sine' },
			filter: { type: 'lowpass', Q: 0.5, rolloff: -12 },
			filterEnvelope: { attack: 1, decay: 1, sustain: 0.8, release: 2, baseFrequency: 60, octaves: 1 },
			envelope: { attack: 1.5, decay: 1, sustain: 0.8, release: 2.5 },
		}));
		const bell = trackNode(new Tone.FMSynth({
			modulationIndex: 8,
			oscillator: { type: 'sine' },
			modulation: { type: 'sine' },
			envelope: { attack: 0.01, decay: 1.2, sustain: 0.05, release: 1.4 },
			modulationEnvelope: { attack: 0.01, decay: 0.6, sustain: 0.1, release: 0.8 },
		}));
		const air = trackNode(new Tone.NoiseSynth({
			noise: { type: 'pink' },
			envelope: { attack: 1.5, decay: 2, sustain: 0.2, release: 2 },
		}));

		const reverb = trackNode(new Tone.Reverb({ decay: 6, wet: 0.45 }));
		const delay = trackNode(new Tone.FeedbackDelay('4n', 0.28));
		const filter = trackNode(new Tone.Filter(1800, 'lowpass'));
		const padGain = trackNode(new Tone.Gain(0.12));
		const droneGain = trackNode(new Tone.Gain(0.16));
		const bellGain = trackNode(new Tone.Gain(0.07));
		const airGain = trackNode(new Tone.Gain(0.025));

		pad.chain(filter, padGain, reverb, mixBus!);
		drone.chain(droneGain, reverb, mixBus!);
		bell.chain(delay, bellGain, reverb, mixBus!);
		air.chain(airGain, reverb, mixBus!);

		const pads = [
			['A2', 'E3', 'B3', 'C#4'],
			['F#2', 'C#3', 'A3', 'B3'],
			['D2', 'A2', 'F#3', 'A3'],
			['E2', 'B2', 'G#3', 'B3'],
		];
		const drones = ['A1', 'F#1', 'D1', 'E1'];
		const bells = ['E5', null, null, null, 'F#5', null, null, 'A5', null, null, 'C#5', null, null, 'B4', null, null];

		trackPart(new Tone.Sequence((time, step) => {
			if (step % 8 === 0) {
				const idx = Math.floor(step / 8) % pads.length;
				pad.triggerAttackRelease(pads[idx], '1m', time, 0.35);
				drone.triggerAttackRelease(drones[idx], '1m', time, 0.45);
				air.triggerAttackRelease('2n', time, 0.15);
			}
			const bellNote = bells[step];
			if (bellNote) bell.triggerAttackRelease(bellNote, '2n', time, 0.3);
		}, Array.from({ length: 16 }, (_, i) => i), '4n').start(0));
	}

	function buildArpPreset() {
		const arp = trackNode(new Tone.Synth({
			oscillator: { type: 'square' },
			envelope: { attack: 0.005, decay: 0.12, sustain: 0.1, release: 0.12 },
		}));
		const bass = trackNode(new Tone.MonoSynth({
			oscillator: { type: 'triangle' },
			filter: { type: 'lowpass', Q: 1.2, rolloff: -24 },
			filterEnvelope: { attack: 0.01, decay: 0.15, sustain: 0.2, release: 0.15, baseFrequency: 70, octaves: 2 },
			envelope: { attack: 0.01, decay: 0.15, sustain: 0.2, release: 0.15 },
		}));
		const pluck = trackNode(new Tone.PluckSynth({ attackNoise: 0.8, dampening: 4200, resonance: 0.85 }));
		const hat = trackNode(new Tone.MetalSynth({
			envelope: { attack: 0.001, decay: 0.08, release: 0.02 },
			harmonicity: 4.5,
			modulationIndex: 20,
			resonance: 3000,
			octaves: 1.2,
		}));

		const delay = trackNode(new Tone.PingPongDelay('16n', 0.22));
		const reverb = trackNode(new Tone.Reverb({ decay: 1.8, wet: 0.18 }));
		const arpGain = trackNode(new Tone.Gain(0.1));
		const bassGain = trackNode(new Tone.Gain(0.22));
		const pluckGain = trackNode(new Tone.Gain(0.12));
		const hatGain = trackNode(new Tone.Gain(0.03));

		arp.chain(delay, arpGain, reverb, mixBus!);
		bass.chain(bassGain, mixBus!);
		pluck.chain(pluckGain, reverb, mixBus!);
		hat.chain(hatGain, mixBus!);

		const patterns = [
			['C4', 'E4', 'G4', 'C5', 'E5', 'G4', 'E4', 'C4'],
			['A3', 'C4', 'E4', 'A4', 'C5', 'E4', 'C4', 'A3'],
			['F3', 'A3', 'C4', 'F4', 'A4', 'C4', 'A3', 'F3'],
			['G3', 'B3', 'D4', 'G4', 'B4', 'D4', 'B3', 'G3'],
		];
		const bassNotes = ['C2', null, 'C2', null, 'A1', null, 'A1', null, 'F1', null, 'F1', null, 'G1', null, 'G1', null];

		trackPart(new Tone.Sequence((time, step) => {
			const pattern = patterns[Math.floor(step / 8) % patterns.length];
			const note = pattern[step % pattern.length];
			arp.triggerAttackRelease(note, '16n', time, 0.45);
			if (step % 2 === 0) pluck.triggerAttack(note, time);
			const bassNote = bassNotes[step % bassNotes.length];
			if (bassNote) bass.triggerAttackRelease(bassNote, '8n', time, 0.6);
			if (step % 2 === 1) hat.triggerAttackRelease('16n', time, 0.15);
		}, Array.from({ length: 16 }, (_, i) => i), '16n').start(0));
	}

	function buildPreset(preset: MusicPreset) {
		disposeToneGraph();
		mixBus = trackNode(new Tone.Gain(1));
		if (eqFilters[0]) mixBus.connect(eqFilters[0]);
		if (rawAnalyser) mixBus.connect(rawAnalyser);

		Tone.Transport.bpm.value = preset.tempo;
		Tone.Transport.swing = 0;
		if (preset.id === 'edm') buildEdmPreset();
		else if (preset.id === 'lofi') buildLofiPreset();
		else if (preset.id === 'ambient') buildAmbientPreset();
		else buildArpPreset();
	}

	async function playSignal() {
		stopSignal(false);
		await Tone.start();
		audioContext = Tone.getContext().rawContext as AudioContext;
		const context = audioContext;
		const now = context.currentTime;

		masterGain = context.createGain();
		const level = Number(volume.value) / 100;
		masterGain.gain.setValueAtTime(0, now);
		masterGain.gain.linearRampToValueAtTime(level, now + 0.05);

		const filterSpecs: Array<[BiquadFilterType, number, number?]> = [
			['lowshelf', 100],
			['peaking', 250, 0.9],
			['peaking', 1000, 1],
			['peaking', 3500, 1],
			['highshelf', 8000],
		];
		eqFilters = filterSpecs.map(([type, frequency, q], index) => {
			const filter = context.createBiquadFilter();
			filter.type = type;
			filter.frequency.setValueAtTime(frequency, now);
			if (q) filter.Q.setValueAtTime(q, now);
			filter.gain.setValueAtTime(selected.eq[index], now);
			return filter;
		});
		eqFilters.forEach((filter, index) => {
			if (index < eqFilters.length - 1) filter.connect(eqFilters[index + 1]);
		});
		eqFilters[eqFilters.length - 1].connect(masterGain);
		masterGain.connect(context.destination);

		rawAnalyser = context.createAnalyser();
		rawAnalyser.fftSize = 256;
		rawAnalyser.smoothingTimeConstant = 0.8;
		analyserSink = context.createGain();
		analyserSink.gain.setValueAtTime(0, now);
		rawAnalyser.connect(analyserSink);
		analyserSink.connect(context.destination);

		liveBarFreqs = getBarFrequencies(context.sampleRate);
		eqMultCache.clear();

		buildPreset(activePreset);
		Tone.Transport.start('+0.05');

		monitorRunning = true;
		cancelAnimationFrame(monitorFrame);
		monitorFrame = requestAnimationFrame(updateSignalCanvases);
		playbackStatus.textContent = `Playing the ${selected.name.toLowerCase()} transformation with the ${activePreset.name} preset.`;
		toggleButton.textContent = 'Stop listening';
	}

	function toggleSignal() {
		if (monitorRunning) stopSignal();
		else playSignal();
	}

	function selectMusicPreset(preset: MusicPreset) {
		activePreset = preset;
		presetButtons.forEach((button) => {
			const active = button.dataset.preset === preset.id;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		});
		if (monitorRunning) {
			const wasRunning = monitorRunning;
			const currentLevel = masterGain?.gain.value ?? Number(volume.value) / 100;
			buildPreset(preset);
			if (wasRunning) {
				Tone.Transport.start();
				if (masterGain && audioContext) {
					const now = audioContext.currentTime;
					masterGain.gain.setValueAtTime(currentLevel, now);
				}
			}
			playbackStatus.textContent = `${preset.name} preset selected. The ${selected.name.toLowerCase()} transformation remains active.`;
		} else {
			playbackStatus.textContent = `${preset.name} preset selected. Press Start listening to hear the ${selected.name.toLowerCase()} transformation.`;
		}
	}

	volume.addEventListener('input', updateOutputs);
	toggleButton.addEventListener('click', toggleSignal);
	presetButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const preset = musicPresets.find((candidate) => candidate.id === button.dataset.preset);
			if (preset) selectMusicPreset(preset);
		});
	});

	let resizeQueued = false;
	const gridResizeObserver = new ResizeObserver(() => {
		if (resizeQueued) return;
		resizeQueued = true;
		requestAnimationFrame(() => {
			resizeQueued = false;
			redrawCurves();
			if (!monitorRunning) updateSignalCanvases();
		});
	});
	gridResizeObserver.observe(tileGrid);

	requestAnimationFrame(() => {
		redrawCurves();
		selectSignature(selected);
	});
	updateOutputs();

	document.addEventListener('astro:before-swap', () => {
		stopSignal(false);
		gridResizeObserver.disconnect();
		disposeToneGraph();
		Tone.getContext().dispose();
		audioContext = null;
		analysisContext?.close();
		analysisContext = null;
	});
</script>

