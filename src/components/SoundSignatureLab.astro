		keys.chain(chorus, mud, filter, keysGain, reverb, mixBus!);
		bass.chain(bassGain, mixBus!);
		lead.chain(mud, filter, leadGain, reverb, mixBus!);
		kick.connect(kickGain);
		snare.connect(snareGain);
		dust.connect(dustGain);
