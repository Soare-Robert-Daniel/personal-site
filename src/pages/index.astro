---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AsciiWave from '../components/AsciiWave.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 data-glitch>Hello, I'm Robert Soare</h1>
				<p class="role" data-glitch>Software Developer</p>
				<p>
					Building products for the WordPress ecosystem that help small business owners and freelancers. Currently at <strong>Themeisle</strong>, serving almost <strong>1 million users</strong>.
				</p>
			</section>

			<AsciiWave />

			<section class="section">
				<h2 class="section-title">Tech Stack</h2>
				<div class="skills">
					<span class="skill-tag">PHP</span>
					<span class="skill-tag">Node.js</span>
					<span class="skill-tag">Bun</span>
					<span class="skill-tag">WordPress</span>
					<span class="skill-tag">React</span>
					<span class="skill-tag">TypeScript</span>
					<span class="skill-tag">AWS</span>
					<span class="skill-tag">MySQL</span>
					<span class="skill-tag">Docker</span>
					<span class="skill-tag">Tailwind</span>
				</div>
			</section>

			<section class="section">
				<h2 class="section-title">Get In Touch</h2>
				<p>Interested in working together?</p>
				<a href="https://www.linkedin.com/in/soare-robert-daniel-949974151/" target="_blank" class="cta-button">Let's Connect on LinkedIn</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}
	.role {
		color: var(--accent);
		font-size: 1.1rem;
		margin-bottom: 1rem;
	}
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.cta-button {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background: var(--accent);
		color: var(--bg-dark);
		border-radius: 8px;
		font-weight: 600;
		transition: all 0.2s ease;
	}
	.cta-button:hover {
		filter: drop-shadow(0 0 10px var(--glow));
		transform: translateY(-2px);
	}
</style>

<script>
	const glitchChars = '█▓▒░@#$%&*!?/\\|<>';

	function randomChar() {
		return glitchChars[Math.floor(Math.random() * glitchChars.length)];
	}

	function glitch(el: Element, delay: number) {
		const text = el.textContent || '';
		const len = text.length;
		const resolved = new Array(len).fill(false);
		const display = text.split('').map((c) => (c === ' ' ? ' ' : randomChar()));
		el.textContent = display.join('');

		const iterations = 24;
		let frame = 0;
		const charDelay = 5;

		setTimeout(() => {
			function step() {
				frame++;
				for (let i = 0; i < len; i++) {
					if (resolved[i] || text[i] === ' ') continue;
					if (frame > i * charDelay + iterations) {
						display[i] = text[i];
						resolved[i] = true;
					} else if (frame > i * charDelay) {
						display[i] = randomChar();
					}
				}
				el.textContent = display.join('');
				if (resolved.every(Boolean)) return;
				requestAnimationFrame(step);
			}
			requestAnimationFrame(step);
		}, delay);
	}

	document.querySelectorAll('[data-glitch]').forEach((el, i) => {
		glitch(el, i * 400);
	});
</script>
